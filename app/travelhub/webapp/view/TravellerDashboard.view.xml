<mvc:View
    controllerName="travelhub.controller.TravellerDashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    displayBlock="true">

    <Page id="pageTravellerDashboard" showHeader="false" busy="{traveller>/busy}">
        <content>
            <VBox class="sapUiMediumMargin">

                <Title text="My Travel Profile" level="H2" class="sapUiSmallMarginBottom"/>

                <core:Fragment fragmentName="travelhub.fragment.TravellerProfile" type="XML"/>

                <core:Fragment fragmentName="travelhub.fragment.SpendDonutChart" type="XML"/>

                <IconTabBar id="tabsTraveller" class="sapUiSmallMarginTop">
                    <items>
                        <IconTabFilter key="addresses" text="Addresses" icon="sap-icon://addresses">
                            <core:Fragment fragmentName="travelhub.fragment.AddressesTab" type="XML"/>
                        </IconTabFilter>
                        <IconTabFilter key="locations" text="Travelled Locations" icon="sap-icon://flight">
                            <core:Fragment fragmentName="travelhub.fragment.TravelledLocationsTab" type="XML"/>
                        </IconTabFilter>
                    </items>
                </IconTabBar>

                <HBox justifyContent="End" class="sapUiSmallMarginTop">
                    <Button id="btnSaveTraveller" text="Save" type="Emphasized" press=".onSave"/>
                </HBox>

            </VBox>
        </content>
    </Page>

</mvc:View>
