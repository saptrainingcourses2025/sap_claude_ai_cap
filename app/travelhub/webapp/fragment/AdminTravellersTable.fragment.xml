<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">

    <Table id="tblAdminTravellers" items="{admin>/travellers}" growing="true" growingThreshold="20">
        <headerToolbar>
            <Toolbar>
                <Title text="Travellers"/>
            </Toolbar>
        </headerToolbar>
        <columns>
            <Column><Text text="Name"/></Column>
            <Column><Text text="Email"/></Column>
            <Column><Text text="Status"/></Column>
            <Column><Text text="Account"/></Column>
            <Column hAlign="Center"><Text text="Active"/></Column>
        </columns>
        <items>
            <ColumnListItem>
                <cells>
                    <Text text="{admin>fullName}"/>
                    <Text text="{admin>email}"/>
                    <Text text="{admin>statusLabel}"/>
                    <ObjectStatus text="{admin>accountLabel}"
                        state="{= ${admin>accountLocked} ? 'Error' : 'Success' }"/>
                    <Switch state="{= !${admin>accountLocked} }" change=".onToggleLock"/>
                </cells>
            </ColumnListItem>
        </items>
    </Table>

</core:FragmentDefinition>
