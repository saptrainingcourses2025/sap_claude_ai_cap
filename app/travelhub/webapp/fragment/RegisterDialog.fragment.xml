<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout">

    <Dialog id="dlgRegister" title="Register as Traveller" contentWidth="420px" busy="{register>/busy}">
        <content>
            <l:VerticalLayout class="sapUiSmallMargin" width="100%">
                <Label text="First Name" labelFor="inpRegFirstName"/>
                <Input id="inpRegFirstName" value="{register>/draft/firstName}" width="100%"/>

                <Label text="Last Name" labelFor="inpRegLastName" class="sapUiTinyMarginTop"/>
                <Input id="inpRegLastName" value="{register>/draft/lastName}" width="100%"/>

                <Label text="Email" labelFor="inpRegEmail" class="sapUiTinyMarginTop"/>
                <Input id="inpRegEmail" type="Email" value="{register>/draft/loginName}" width="100%"/>

                <Label text="Password" labelFor="inpRegPassword" class="sapUiTinyMarginTop"/>
                <Input id="inpRegPassword" type="Password" value="{register>/draft/password}" width="100%"/>

                <Label text="Phone" labelFor="inpRegPhone" class="sapUiTinyMarginTop"/>
                <Input id="inpRegPhone" value="{register>/draft/phone}" width="100%"/>

                <Label text="Address Type" labelFor="selRegAddressType" class="sapUiTinyMarginTop"/>
                <Select id="selRegAddressType" selectedKey="{register>/draft/addressType}"
                        items="{register>/addressTypes}" width="100%">
                    <core:Item key="{register>code}" text="{register>name}"/>
                </Select>
            </l:VerticalLayout>
        </content>
        <beginButton>
            <Button text="Submit" type="Emphasized" press=".onRegisterSubmit"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onRegisterCancel"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>
