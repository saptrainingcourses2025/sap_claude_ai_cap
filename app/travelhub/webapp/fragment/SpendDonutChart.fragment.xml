<!--
    Originally spec'd as a spend-by-destination donut (SUM(amount)). The
    backing entity (TravelledLocations) has no amount/spend field, so this
    renders a trip-count-per-destination donut instead, aggregated in the
    controller with a plain JS reduce over already-loaded data — no new
    backend endpoint or field required.
-->
<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:vizData="sap.viz.ui5.data"
    xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds">

    <VBox class="sapUiSmallMarginTop">
        <Title text="{view>/chartTitle}" level="H3" class="sapUiSmallMarginBottom"/>
        <viz:VizFrame id="idTripsDonutChart" uiConfig="{applicationSet:'fiori'}"
            height="280px" width="100%" vizType="donut">
            <viz:dataset>
                <vizData:FlattenedDataset data="{view>/chartData}">
                    <vizData:dimensions>
                        <vizData:DimensionDefinition name="Destination" value="{view>name}"/>
                    </vizData:dimensions>
                    <vizData:measures>
                        <vizData:MeasureDefinition name="Trips" value="{view>value}"/>
                    </vizData:measures>
                </vizData:FlattenedDataset>
            </viz:dataset>
            <viz:feeds>
                <vizFeeds:FeedItem uid="size" type="Measure" values="Trips"/>
                <vizFeeds:FeedItem uid="color" type="Dimension" values="Destination"/>
            </viz:feeds>
        </viz:VizFrame>
    </VBox>

</core:FragmentDefinition>
